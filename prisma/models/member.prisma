enum MemberStatus {
  ACTIVE
  INACTIVE
  /// Removed from the Clerk org but kept locally, because Task/Doc/
  /// Transaction/Penalty all reference Member with `Restrict` and deleting
  /// the row would take their authorship with it. Distinct from INACTIVE
  /// ("on leave, still on the team") — the admin console's member count and
  /// the Clerk sync action need to tell those two apart, which is exactly
  /// what the silent count inflation came down to.
  REMOVED
}

enum FunctionalRole {
  PITCHING
  DOCUMENTS
  CREATIVES
  PRODUCTION
  QUALITY_ASSURANCE
  MARKETING
  MODEL
}

enum WorkDistributionRole {
  HACKATHON_HUNTER
  PROJECT_SCAVENGER_CREATOR
}

model Member {
  id          String       @id @default(cuid())
  clerkUserId String       @unique
  email       String
  displayName String
  avatarUrl   String?
  status      MemberStatus @default(ACTIVE)
  // True for exactly one member (the org's Leader). Not editable through any
  // app UI — see architecture-context.md's Auth and Roles Model. Admin/member
  // permission itself is Clerk's org:admin/org:member, never stored here.
  isLeader    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  functionalRoles       MemberFunctionalRole[]
  workDistributionRoles MemberWorkDistributionRole[]
  createdTasks          Task[]                       @relation("TaskCreatedBy")
  taskAssignments       TaskAssignee[]               @relation("TaskAssignments")
  transactions          Transaction[]
  docs                  Doc[]
  calendarEvents        CalendarEvent[]
  googleCalendarSyncs   GoogleCalendarSyncedEvent[]
  ownedProjects         Project[]                    @relation("ProjectOwner")
  projectMemberships    ProjectMember[]
  organizedMeetings     Meeting[]                     @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]          @relation("MeetingParticipations")
  proposedAgendaItems   AgendaProposal[]              @relation("AgendaProposalAuthor")
  addedAgendaItems      AgendaItem[]                  @relation("AgendaItemAddedBy")
  penaltiesReceived     Penalty[]                     @relation("PenaltyRecipient")
  penaltiesIssued       Penalty[]                     @relation("PenaltyIssuer")
  auditLogEntries       AuditLog[]                    @relation("AuditActor")
  roleChangeRequests    MemberRequest[]               @relation("MemberRequestSubject")
  decidedMemberRequests MemberRequest[]               @relation("MemberRequestDecider")
  sentBroadcasts        Broadcast[]                   @relation("BroadcastSender")
  receivedBroadcasts    BroadcastRecipient[]          @relation("BroadcastRecipient")
  targetedBroadcasts    Broadcast[]                   @relation("BroadcastAudienceMember")
  duesAssessments       DuesAssessment[]              @relation("DuesAssessments")
  announcements         Announcement[]                @relation("AnnouncementAuthor")
  announcementDismissals AnnouncementDismissal[]      @relation("AnnouncementDismissals")
  ideaVotes             IdeaVote[]                    @relation("IdeaVotes")
  activityActed         ActivityEvent[]               @relation("ActivityActor")
  activityReceived      ActivityEvent[]               @relation("ActivityAudience")
  penaltyDisputes       PenaltyDispute[]              @relation("PenaltyDisputes")
  createdHackathons     Hackathon[]                   @relation("HackathonCreator")

  @@index([clerkUserId])
  // Member.email has no @unique — one person can legitimately hold two Clerk
  // accounts. This index exists so the Clerk sync action can find same-email
  // duplicates cheaply instead of scanning, since that's one of the shapes a
  // wrong member count takes.
  @@index([email])
}

model MemberFunctionalRole {
  id       String         @id @default(cuid())
  memberId String
  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     FunctionalRole

  @@unique([memberId, role])
  @@index([role])
}

model MemberWorkDistributionRole {
  id       String               @id @default(cuid())
  memberId String
  member   Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     WorkDistributionRole

  @@unique([memberId, role])
  @@index([role])
}
