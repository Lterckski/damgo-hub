enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

// All amounts are integer centavos, PHP — see 07-financial-tracker.md's
// Currency section and architecture-context.md invariant 8. Never a float.
model Transaction {
  id          String            @id @default(cuid())
  memberId    String
  member      Member            @relation(fields: [memberId], references: [id])
  type        TransactionType
  category    String
  amount      Int
  description String?
  receiptPath String?
  status      TransactionStatus @default(PENDING)
  // Set only on the Transaction auto-created when an Admin resolves a
  // monetary penalty (18-penalty-tracker.md) — never by the manual
  // POST /api/finance/transactions flow. No onDelete override: there's no
  // "delete a penalty" flow anywhere in the app, so the default Restrict
  // behavior (block deleting a Penalty row that still has this
  // Transaction attached) is exactly what should happen if that's ever
  // added later, rather than silently orphaning financial history.
  penaltyId   String?           @unique
  penalty     Penalty?          @relation(fields: [penaltyId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  /// Set when this ledger entry is what settled a dues assessment.
  duesAssessment DuesAssessment?

  @@index([memberId])
  @@index([type])
}
