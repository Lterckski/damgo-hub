# Copy this to .env and fill in real values — ask the Leader for the
# team's shared keys rather than creating your own for most of these.
# First .env.example added in 16-meeting-scheduling.md; backfilled with
# every other var already in use so this file is a complete reference,
# not just the meeting-email ones this unit introduced.

# --- Database (Prisma Postgres) ---
DATABASE_URL=

# --- Clerk (auth + org roles) ---
# Optional: pin the deployment to the seeded leader's verified org. Required
# when that leader belongs to more than one organization. Does not enable
# multiple organizations; HubWorkspace persists the verified binding.
CLERK_ORGANIZATION_ID=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Liveblocks (collaborative boards — 12-liveblocks-setup.md) ---
LIVEBLOCKS_SECRET_KEY=
NEXT_PUBLIC_LIVEBLOCKS_API_KEY=

# --- Trigger.dev (background jobs) ---
TRIGGER_SECRET_KEY=

# --- Google Drive Picker (09-documentation.md) ---
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# --- Vercel Blob (receipts, doc attachments, board snapshots) ---
BLOB_READ_WRITE_TOKEN=

# --- Resend (meeting email — 16-meeting-scheduling.md) ---
# Server-only. Create a Resend account, verify a sending domain, and
# create an API key before this does anything beyond silently no-op.
RESEND_API_KEY=
# Must be an address on the verified Resend domain, e.g.
# "Damgo Hub <meetings@yourdomain.com>".
MEETING_EMAIL_FROM=
# The canonical production origin (no trailing slash), e.g.
# "https://damgo-hub.vercel.app" — used to build /meetings/[id] links in
# email so they never point at a preview deployment's URL.
APP_URL=

# --- Core Web Vitals RUM (production observation only) ---
# Build-time switch for Speed Insights and authenticated workspace collection.
NEXT_PUBLIC_RUM_ENABLED=false
# Runtime switch for ingestion AND the Trigger.dev hourly percentile task.
RUM_ENABLED=false
# Fallback if Vercel's NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA is not exposed.
NEXT_PUBLIC_RUM_RELEASE=
